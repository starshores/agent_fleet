{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "65",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
    "CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP": "1"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/apphome/agent_fleet/hooks/block_askuser.py",
            "timeout": 15,
            "statusMessage": "AskUserQuestion→非阻塞待办池(不占会话)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/apphome/agent_fleet/hooks/turn_state.py",
            "timeout": 10,
            "statusMessage": "turn状态:跑工具",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/apphome/agent_fleet/hooks/on_memory_write.py",
            "timeout": 30,
            "statusMessage": "刷新记忆硬链备份"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/apphome/agent_fleet/hooks/turn_state.py",
            "timeout": 10,
            "statusMessage": "turn状态:回思考",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/apphome/agent_fleet/hooks/turn_state.py",
            "timeout": 10,
            "statusMessage": "turn状态:空闲等输入"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/apphome/agent_fleet/hooks/reinject_post_compact.py",
            "timeout": 15,
            "statusMessage": "compact后自定位:重认身份+重载纪律"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/apphome/agent_fleet/hooks/turn_state.py",
            "timeout": 10,
            "statusMessage": "turn状态:思考/执行中"
          },
          {
            "type": "command",
            "command": "python C:/apphome/agent_fleet/hooks/user_prompt_anchor.py",
            "timeout": 10,
            "statusMessage": "插话纠偏锚:核手头processing"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/apphome/agent_fleet/hooks/turn_state.py",
            "timeout": 10,
            "statusMessage": "turn状态:空闲"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "feedbackSurveyRate": 0,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "_env_note_reap": "2026-09-24 用户确认:禁 Claude Code 低内存回收后台任务(④型掉线根因·近3天20次);同时已 setx 用户级环境变量·此处并记=换机回填不丢(settings env 对新会话同样生效)"
}