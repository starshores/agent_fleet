#!/bin/sh
# reference-transaction 钩子:打 vX tag 时【自动 snapshot 一份 zip】到同级 agent_fleet_releases/。
# git 没有原生 post-tag 钩子;reference-transaction 在任何 ref 更新时触发,这里只挑【新建的 refs/tags/v*】动作。
# 普通 commit 的 ref 更新不匹配即跳过;snapshot 只跑 tar(不调 git),无 re-entrancy。
# 随 agent_fleet 迁移:靠 git config core.hooksPath githooks(相对路径,从仓库根解析)。
[ "$1" = "committed" ] || exit 0

REPO="$(pwd)"
PARENT="$(dirname "$REPO")"
NAME="$(basename "$REPO")"
REL="$PARENT/${NAME}_releases"
TAR="/c/Windows/System32/tar.exe"   # bsdtar(能出 zip);换非 Windows 机需改

while read -r old new ref; do
  # 只认版本 tag 的新建
  case "$ref" in
    refs/tags/v*) ;;
    *) continue ;;
  esac
  case "$new" in *[!0]*) ;; *) continue ;; esac   # new 全 0 = 删 tag,跳过(只在建/移 tag 时 snapshot)
  tag="${ref#refs/tags/}"
  mkdir -p "$REL"
  out="$REL/${NAME}_${tag}.zip"
  # 强移 tag(git tag -f)也重打 snapshot,保 zip 与 tag 指向一致(P2 修:原"已存在即跳过"
  # 会让强移后的 zip 停在旧内容,与"snapshot=该 tag 时刻"的注释矛盾)。旧 zip 先留 .prev 一代可回看。
  [ -f "$out" ] && { mv -f "$out" "$out.prev" 2>/dev/null; echo "[release-hook] $tag 已存在→刷新(旧件留 .prev)"; }
  # 注:zip 含运行态 db(usage.db 等);打包瞬间若有写入,db 快照可能非事务一致——
  # 发版 zip 定位是【代码+当时状态的粗快照】,精确迁移走"停写后整目录拷贝"路径。
  # projects/ = 全部 agent 会话运行态(2026-07-28 迁入·含业务库 junction,bsdtar 会追进去=数百MB),
  # 发版 zip 是【代码快照】不带它;整目录迁移走文件夹拷贝路径、自然带上。
  if "$TAR" -a -c -f "$out" -C "$PARENT" --exclude='*__pycache__*' --exclude="${NAME}/projects" "$NAME" 2>/dev/null; then
    echo "[release-hook] 已 snapshot $tag -> $out"
  else
    echo "[release-hook] snapshot $tag 失败(检查 tar 路径/权限)"
  fi
done
exit 0
