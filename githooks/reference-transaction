#!/bin/sh
# reference-transaction 钩子:打 vX tag 时【自动 snapshot 一份 zip】到同级 agent_fleet_releases/。
# git 没有原生 post-tag 钩子;reference-transaction 在任何 ref 更新时触发,这里只挑【新建的 refs/tags/v*】动作。
# 普通 commit 的 ref 更新不匹配即跳过;snapshot 只跑 tar(不调 git),无 re-entrancy。
# 随 agent_fleet 迁移:靠 git config core.hooksPath githooks(相对路径,从仓库根解析)。
[ "$1" = "committed" ] || exit 0

REPO="$(pwd)"
PARENT="$(dirname "$REPO")"
NAME="$(basename "$REPO")"
REL="$PARENT/${NAME}_releases"
TAR="/c/Windows/System32/tar.exe"   # bsdtar(能出 zip);换非 Windows 机需改

while read -r old new ref; do
  # 只认版本 tag 的新建
  case "$ref" in
    refs/tags/v*) ;;
    *) continue ;;
  esac
  case "$new" in *[!0]*) ;; *) continue ;; esac   # new 全 0 = 删 tag,跳过(只在建/移 tag 时 snapshot)
  tag="${ref#refs/tags/}"
  mkdir -p "$REL"
  out="$REL/${NAME}_${tag}.zip"
  [ -f "$out" ] && { echo "[release-hook] $tag 已存在,跳过"; continue; }
  if "$TAR" -a -c -f "$out" -C "$PARENT" --exclude='*__pycache__*' "$NAME" 2>/dev/null; then
    echo "[release-hook] 已 snapshot $tag -> $out"
  else
    echo "[release-hook] snapshot $tag 失败(检查 tar 路径/权限)"
  fi
done
exit 0
